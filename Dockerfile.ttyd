FROM ubuntu:22.04

# Install ttyd, vim, python, and other useful tools
RUN apt-get update && \
    apt-get install -y \
    ttyd \
    vim \
    curl \
    git \
    python3 \
    python3-pip \
    sqlite3 \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

EXPOSE 7681

# Run ttyd with bash
CMD ["ttyd", "-p", "7681", "bash"]