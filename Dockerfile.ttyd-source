FROM ubuntu:22.04

# Install build dependencies and runtime tools
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
    vim \
    curl \
    git \
    python3 \
    python3-pip \
    sqlite3 \
    build-essential \
    cmake \
    libjson-c-dev \
    libwebsockets-dev \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Build ttyd from source
WORKDIR /tmp
RUN git clone --depth 1 https://github.com/tsl0922/ttyd.git && \
    cd ttyd && \
    mkdir build && \
    cd build && \
    cmake .. && \
    make && \
    make install && \
    cd / && \
    rm -rf /tmp/ttyd

EXPOSE 7681

WORKDIR /workspace

# Run ttyd with bash
CMD ["ttyd", "-p", "7681", "bash"]
